# Optional auxiliary API configuration only.
# The Tier-A SUTURE backbone, adapter, scoring, and data pipeline run locally
# from pinned Hugging Face checkpoints and do not read these variables.
OPENROUTER_AUXILIARY_ONLY=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Populate only for a separately versioned translation or judging run.
OPENROUTER_TRANSLATION_MODEL=
OPENROUTER_JUDGE_MODEL=
OPENROUTER_LLM_BACKBONES=
